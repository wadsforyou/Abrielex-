{
  "name": "NotificationTemplate",
  "type": "object",
  "properties": {
    "event": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "inapp"
      ]
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "event",
    "channel",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}