{
  "name": "PortalTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "assignee_id": {
      "type": "string"
    },
    "assignee_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "internal",
        "client",
        "case",
        "follow_up",
        "renewal"
      ],
      "default": "client"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done",
        "cancelled"
      ],
      "default": "open"
    },
    "internal": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "customer_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.id}}"
            },
            {
              "data.internal": {
                "$ne": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}