{
  "name": "NotificationSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "email_enabled": {
      "type": "boolean",
      "default": true
    },
    "whatsapp_enabled": {
      "type": "boolean",
      "default": false
    },
    "inapp_enabled": {
      "type": "boolean",
      "default": true
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "whatsapp_provider": {
      "type": "string"
    },
    "whatsapp_configured": {
      "type": "boolean",
      "default": false
    },
    "reminder_levels": {
      "type": "string"
    },
    "admin_notify_email": {
      "type": "string"
    },
    "quote_recipients": {
      "type": "string"
    },
    "consultation_recipients": {
      "type": "string"
    },
    "contact_recipients": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}