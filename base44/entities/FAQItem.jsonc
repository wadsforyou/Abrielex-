{
  "name": "FAQItem",
  "type": "object",
  "properties": {
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "general",
        "country"
      ],
      "default": "general"
    },
    "country_code": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}