{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Sole Proprietor",
        "Partnership",
        "Private Limited Company",
        "Public Limited Company",
        "Section 27/NGO",
        "Cooperative",
        "Trust",
        "Other"
      ]
    },
    "industry": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "tax_id": {
      "type": "string"
    },
    "business_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "dormant",
        "in_formation"
      ],
      "default": "in_formation"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "country"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}