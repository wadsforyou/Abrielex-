{
  "name": "PortalMessage",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "customer",
        "staff"
      ],
      "default": "customer"
    },
    "sender_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    },
    "attachment_name": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_id",
    "sender",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}