{
  "name": "RolePermission",
  "type": "object",
  "properties": {
    "role": {
      "type": "string"
    },
    "sections": {
      "type": "string"
    },
    "permissions": {
      "type": "string"
    },
    "is_system": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}