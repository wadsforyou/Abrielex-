{
  "name": "Deadline",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "annual_return",
        "tax_filing",
        "praz_renewal",
        "license_renewal",
        "vendor_renewal",
        "bookkeeping",
        "statutory",
        "other"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "due_soon",
        "overdue",
        "done",
        "cancelled"
      ],
      "default": "upcoming"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "customer_id",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}