{
  "name": "CaseUpdate",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "internal": {
      "type": "boolean",
      "default": false
    },
    "new_status": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "customer_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_id": "{{user.id}}"
            },
            {
              "data.internal": {
                "$ne": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}